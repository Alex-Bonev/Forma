# Copy to backend/.env (gitignored) for the local demo server. Real environment variables win over this file.
MOCK=1                     # 1: canned responses, no keys needed. 0: call the real providers below.
APP_SHARED_SECRET=         # required when MOCK=0; the app sends it as X-App-Secret. Generate: openssl rand -hex 32
# Gemini API (render) - key from aistudio.google.com, billing on (no free tier for image output)
IMAGE_API_KEY=
IMAGE_MODEL=gemini-nano-banana-2.1   # image model for /render
IMAGE_SIZE=1K              # render size: 512, 1K or 2K
# Anthropic (vibe style analysis)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5  # model for /vibe/analyze
# SerpAPI Google Shopping (quick search fallback, /vibe/products)
SHOPPING_API_KEY=
# Browser Use Cloud (shopping agents, /vibe/shop) - key from cloud.browser-use.com
BROWSER_USE_API_KEY=
BROWSER_USE_MODEL=         # empty: Browser Use's default agent model
BROWSER_USE_MAX_COST=0.5   # USD cap per agent run
# fal (SAM 3D Objects, /vibe/model3d) - key from fal.ai
FAL_KEY=
# Size caps: bound server memory and what the phone downloads over Wi-Fi
MAX_UPLOAD_MB=10           # each image upload, and all images in one request together
MAX_RESPONSE_MB=20         # base64 render returned to the app
USDZ_MAX_MB=8              # converted 3D model package
USDZ_MAX_FACES=80000       # starting triangle budget for 3D models (halved until the package fits)
